enzymeR::kinetics
# Load sample dataset or simulate
sim_data <- simulate_kinetics(
time = seq(0, 10, length.out = 50),
params = list(S0 = 10, Km = 0.5, Vmax = 2.0),
noise_model = "gaussian"
)
sim_data
